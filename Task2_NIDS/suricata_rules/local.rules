alert icmp any any -> $HOME_NET any (msg:"ICMP Ping Detected"; sid:1000001; rev:1;)
alert tcp any any -> $HOME_NET 22 (msg:"Possible SSH Brute Force"; flow:to_server; threshold:type both, track by_src, count 5, seconds 60; sid:1000002; rev:1;)
alert http any any -> $HOME_NET any (msg:"Suspicious User-Agent"; http.user_agent; content:"sqlmap"; sid:1000003; rev:1;)